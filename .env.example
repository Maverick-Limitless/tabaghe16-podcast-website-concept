# Optional, build-time only. No other environment variable is required to
# install, develop, sync, test, build, or preview this project.
#
# Absolute origin used to build canonical URLs, the sitemap, and Open Graph
# URLs. Leave unset for local work: the default http://localhost:4173 matches
# the preview server, so an unset build honestly reports a local origin.
# Set to the real https:// origin before a public build.
PUBLIC_ORIGIN=http://localhost:4173
