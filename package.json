{
  "name": "tabaghe16-website-concept",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "description": "Independent, unapproved concept proposal for a Persian-first website for the Tabaghe 16 (طبقه ۱۶) podcast. Not the official site.",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "sync": "tsx scripts/sync.ts"
  },
  "dependencies": {
    "@fontsource-variable/estedad": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "fast-xml-parser": "5.11.2",
    "sanitize-html": "2.18.1",
    "svelte": "5.57.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
